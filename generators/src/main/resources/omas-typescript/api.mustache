function build{{operationName}}Query(
	request: {{requestType}},
): ReadonlyArray<readonly [string, string]> {
	const query: Array<readonly [string, string]> = [];
{{#queryFields}}
{{^required}}
	if (request.{{name}} !== undefined) {
{{/required}}
{{#array}}
		for (const value of request.{{name}}) {
			query.push(["{{baseName}}", String(value)]);
		}
{{/array}}
{{^array}}
		query.push(["{{baseName}}", String(request.{{name}})]);
{{/array}}
{{^required}}
	}
{{/required}}
{{/queryFields}}
	return query;
}

function build{{operationName}}Headers(request: {{requestType}}): Headers {
	const headers = new Headers();
{{#headerFields}}
{{^required}}
	if (request.{{name}} !== undefined) {
{{/required}}
		headers.set("{{baseName}}", String(request.{{name}}));
{{^required}}
	}
{{/required}}
{{/headerFields}}
	return headers;
}
{{#hasBody}}

function build{{operationName}}Body(request: {{requestType}}): Record<string, unknown> {
	const body: Record<string, unknown> = {};
{{#bodyFields}}
	if (request.{{name}} !== undefined) {
		body["{{baseName}}"] = request.{{name}};
	}
{{/bodyFields}}
	return body;
}
