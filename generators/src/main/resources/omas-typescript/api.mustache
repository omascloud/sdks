export class {{clientClass}} {
	readonly #runtime: ClientRuntime;

	constructor(options: ClientOptions) {
		this.#runtime = new ClientRuntime(
			"{{serviceName}}",
			"{{serverUrl}}",
			options,
			decode{{serviceClass}}ApiError,
		);
	}
{{#clientOperations}}

	async {{operationId}}(
		request: {{requestType}},
		options?: CallOptions,
	): Promise<{{returnType}}> {
		validate{{operationName}}Request(request);
		return this.#runtime.request<{{returnType}}>(
			{
				operationId: "{{operationId}}",
				method: "{{httpMethod}}",
				path: {{{pathExpression}}},
				query: build{{operationName}}Query(request),
				headers: build{{operationName}}Headers(request),
{{#hasBody}}
				body: build{{operationName}}Body(request),
{{/hasBody}}
			},
			options,
		);
	}
{{/clientOperations}}
}
